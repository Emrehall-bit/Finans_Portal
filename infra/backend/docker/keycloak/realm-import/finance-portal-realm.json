{
  "realm": "finance-portal",
  "enabled": true,
  "displayName": "Finance Portal",
  "loginTheme": "finance-portal",
  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "defaultLocale": "tr",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "finance-portal-backend",
      "name": "finance-portal-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"]


    },
    {
      "clientId": "finance-portal-frontend",
      "name": "finance-portal-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "adminUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "GUEST",        "description": "Giriş yapmadan erişim" },
      { "name": "USER",         "description": "Kayıtlı standart kullanıcı" },
      { "name": "USER_PREMIUM", "description": "Premium özellikli kullanıcı" },
      { "name": "ADMIN",        "description": "Sistem yöneticisi" }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "email": "testuser@financeportal.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "test123", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "premiumuser",
      "email": "premium@financeportal.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Premium",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "premium123", "temporary": false }],
      "realmRoles": ["USER_PREMIUM"]
    },
    {
      "username": "adminuser",
      "email": "admin@financeportal.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }

  ],
  "defaultRole": {
    "name": "USER"
  },
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ldap-provider",
        "name": "openldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "ldap-username-mapper",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute":             ["uid"],
                "is.mandatory.in.ldap":       ["true"],
                "read.only":                  ["true"],
                "always.read.value.from.ldap":["false"],
                "user.model.attribute":       ["username"]
              }
            },
            {
              "id": "ldap-email-mapper",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute":             ["mail"],
                "is.mandatory.in.ldap":       ["false"],
                "read.only":                  ["false"],
                "always.read.value.from.ldap":["false"],
                "user.model.attribute":       ["email"]
              }
            },
            {
              "id": "ldap-firstname-mapper",
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute":             ["givenName"],
                "is.mandatory.in.ldap":       ["false"],
                "read.only":                  ["false"],
                "always.read.value.from.ldap":["false"],
                "user.model.attribute":       ["firstName"]
              }
            },
            {
              "id": "ldap-lastname-mapper",
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute":             ["sn"],
                "is.mandatory.in.ldap":       ["true"],
                "read.only":                  ["false"],
                "always.read.value.from.ldap":["false"],
                "user.model.attribute":       ["lastName"]
              }
            },
            {
              "id": "ldap-fullname-mapper",
              "name": "full name",
              "providerId": "full-name-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.full.name.attribute": ["cn"],
                "read.only":               ["false"],
                "write.only":              ["true"]
              }
            }
          ]
        },
        "config": {
          "enabled":                ["true"],
          "priority":               ["0"],
          "editMode":               ["WRITABLE"],
          "syncRegistrations":      ["true"],
          "vendor":                 ["other"],
          "usernameLDAPAttribute":  ["uid"],
          "rdnLDAPAttribute":       ["uid"],
          "uuidLDAPAttribute":      ["entryUUID"],
          "userObjectClasses":      ["inetOrgPerson"],
          "connectionUrl":          ["ldap://openldap:389"],
          "usersDn":                ["ou=users,dc=financeportal,dc=local"],
          "authType":               ["simple"],
          "bindDn":                 ["cn=admin,dc=financeportal,dc=local"],
          "bindCredential":         ["ldapadmin123"],
          "searchScope":            ["1"],
          "validatePasswordPolicy": ["false"],
          "trustEmail":             ["true"],
          "useTruststoreSpi":       ["never"],
          "connectionPooling":      ["true"],
          "pagination":             ["true"],
          "importEnabled":          ["true"],
          "batchSizeForSync":       ["1000"],
          "fullSyncPeriod":         ["-1"],
          "changedSyncPeriod":      ["-1"],
          "cachePolicy":            ["DEFAULT"]
        }
      }
    ]
  }
}
