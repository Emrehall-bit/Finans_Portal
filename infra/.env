# ─── OpenLDAP (dev/local only) ───────────────────────────────────────────────
# Bu dosyayı kopyalayıp infra/.env olarak kaydet.
# Gerçek değerleri ASLA commit etme.

# OpenLDAP admin hesabı → cn=admin,dc=financeportal,dc=local
LDAP_ADMIN_PASSWORD=ldapadmin123

# Keycloak'ın LDAP bind için kullandığı read-only hesap
# → cn=readonly,dc=financeportal,dc=local  (osixia image otomatik yaratır)
#
# [!] DEV DEFAULT — Bu değer realm JSON ile eşleşmeli:
#     infra/backend/docker/keycloak/realm-import/finance-portal-realm.json
#     "bindCredential": ["ldapreadonly123"]
#
# Bu değeri değiştirirsen realm JSON'daki bindCredential'ı da güncelle
# VEYA Keycloak Admin UI → User Federation → openldap → Credentials sekmesinden düzenle.
LDAP_READONLY_PASSWORD=ldapreadonly123
