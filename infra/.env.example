# ─── OpenLDAP ────────────────────────────────────────────────────────────────
# Bu dosyayı kopyalayıp infra/.env olarak kaydet.
# Gerçek değerleri ASLA commit etme.

# OpenLDAP admin hesabı → cn=admin,dc=financeportal,dc=local
#
# [!] Bu değer Keycloak federation bindCredential ile eşleşmeli:
#     infra/backend/docker/keycloak/realm-import/finance-portal-realm.json
#     "bindDn": "cn=admin,dc=financeportal,dc=local"
#     "bindCredential": ["ldapadmin123"]
#
# Keycloak bu hesapla LDAP'a bağlanır; kullanıcı oluşturma, okuma ve
# şifre güncelleme işlemleri bu hesap üzerinden yapılır.
#
# Production için: cn=admin yerine ou=users altında yazma yetkili
# ayrı bir service account oluşturulmalı (bkz. README).
LDAP_ADMIN_PASSWORD=ldapadmin123

# cn=readonly hesabı (osixia/openldap tarafından otomatik oluşturulur)
# Artık Keycloak federation tarafından kullanılmıyor; LDAP içinde mevcut.
LDAP_READONLY_PASSWORD=ldapreadonly123
