<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="http://www.jboss.org/drools"
             targetNamespace="http://www.jboss.org/drools">

    <signal id="premium-payment-outcome"        name="premium-payment-outcome"/>
    <signal id="premium-cancel-requested"       name="premium-cancel-requested"/>
    <signal id="premium-active-cancel-requested" name="premium-active-cancel-requested"/>

    <process id="premium-upgrade-process" name="Premium Upgrade Process" isExecutable="true">
        <property id="subscriptionId" name="subscriptionId" itemSubjectRef="xsd:long"/>
        <property id="paymentSuccess"  name="paymentSuccess"  itemSubjectRef="xsd:boolean"/>

        <startEvent id="StartEvent_1" name="Start"/>

        <!-- ── Upgrade path ── -->

        <task id="Task_Requested" name="PremiumRequested" tns:taskName="PremiumRequested">
            <ioSpecification>
                <dataInput id="Task_Requested_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_Requested_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_Requested_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <task id="Task_PaymentPending" name="PaymentPending" tns:taskName="PaymentPending">
            <ioSpecification>
                <dataInput id="Task_PaymentPending_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_PaymentPending_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_PaymentPending_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <eventBasedGateway id="Gateway_Wait" name="Wait Payment Or Cancel" gatewayDirection="Diverging"/>

        <intermediateCatchEvent id="Catch_PaymentOutcome" name="Payment Outcome">
            <signalEventDefinition signalRef="premium-payment-outcome"/>
        </intermediateCatchEvent>

        <exclusiveGateway id="Gateway_Result" name="Payment Success?" gatewayDirection="Diverging" default="Flow_Fail"/>

        <task id="Task_Active" name="ActivatePremium" tns:taskName="ActivatePremium">
            <ioSpecification>
                <dataInput id="Task_Active_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_Active_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_Active_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <task id="Task_Failed" name="PaymentFailed" tns:taskName="PaymentFailed">
            <ioSpecification>
                <dataInput id="Task_Failed_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_Failed_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_Failed_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <!-- ── Pre-activation cancel path ── -->

        <intermediateCatchEvent id="Catch_Cancel" name="Cancel Requested">
            <signalEventDefinition signalRef="premium-cancel-requested"/>
        </intermediateCatchEvent>

        <task id="Task_Cancelled" name="CancelUpgrade" tns:taskName="CancelUpgrade">
            <ioSpecification>
                <dataInput id="Task_Cancelled_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_Cancelled_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_Cancelled_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <!-- ── Active subscription cancellation path ── -->

        <intermediateCatchEvent id="Catch_ActiveCancel" name="Active Cancel Requested">
            <signalEventDefinition signalRef="premium-active-cancel-requested"/>
        </intermediateCatchEvent>

        <task id="Task_CancellationRequested" name="CancellationRequested" tns:taskName="CancellationRequested">
            <ioSpecification>
                <dataInput id="Task_CancellationRequested_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_CancellationRequested_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_CancellationRequested_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <task id="Task_CancelledFromActive" name="CancelActivePremium" tns:taskName="CancelActivePremium">
            <ioSpecification>
                <dataInput id="Task_CancelledFromActive_sid_in" name="subscriptionId"/>
                <inputSet><dataInputRefs>Task_CancelledFromActive_sid_in</dataInputRefs></inputSet>
            </ioSpecification>
            <dataInputAssociation>
                <sourceRef>subscriptionId</sourceRef>
                <targetRef>Task_CancelledFromActive_sid_in</targetRef>
            </dataInputAssociation>
        </task>

        <!-- ── End events ── -->

        <endEvent id="End_Failed"          name="Failed End"/>
        <endEvent id="End_Cancelled"       name="Cancelled End"/>
        <endEvent id="End_CancelledActive" name="Active Cancellation End"/>

        <!-- ── Sequence flows ── -->

        <sequenceFlow id="Flow_1"    sourceRef="StartEvent_1"               targetRef="Task_Requested"/>
        <sequenceFlow id="Flow_2"    sourceRef="Task_Requested"             targetRef="Task_PaymentPending"/>
        <sequenceFlow id="Flow_3"    sourceRef="Task_PaymentPending"        targetRef="Gateway_Wait"/>
        <sequenceFlow id="Flow_4"    sourceRef="Gateway_Wait"               targetRef="Catch_PaymentOutcome"/>
        <sequenceFlow id="Flow_5"    sourceRef="Gateway_Wait"               targetRef="Catch_Cancel"/>
        <sequenceFlow id="Flow_6"    sourceRef="Catch_PaymentOutcome"       targetRef="Gateway_Result"/>
        <sequenceFlow id="Flow_7"    sourceRef="Gateway_Result"             targetRef="Task_Active">
            <conditionExpression><![CDATA[return paymentSuccess == true;]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="Flow_Fail" sourceRef="Gateway_Result"             targetRef="Task_Failed"/>
        <sequenceFlow id="Flow_10"   sourceRef="Task_Failed"                targetRef="End_Failed"/>
        <sequenceFlow id="Flow_11"   sourceRef="Catch_Cancel"               targetRef="Task_Cancelled"/>
        <sequenceFlow id="Flow_12"   sourceRef="Task_Cancelled"             targetRef="End_Cancelled"/>
        <sequenceFlow id="Flow_9"    sourceRef="Task_Active"                targetRef="Catch_ActiveCancel"/>
        <sequenceFlow id="Flow_13"   sourceRef="Catch_ActiveCancel"         targetRef="Task_CancellationRequested"/>
        <sequenceFlow id="Flow_14"   sourceRef="Task_CancellationRequested" targetRef="Task_CancelledFromActive"/>
        <sequenceFlow id="Flow_15"   sourceRef="Task_CancelledFromActive"   targetRef="End_CancelledActive"/>
    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="premium-upgrade-process">
            <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
                <dc:Bounds x="50" y="182" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_Requested" bpmnElement="Task_Requested">
                <dc:Bounds x="130" y="170" width="130" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_PaymentPending" bpmnElement="Task_PaymentPending">
                <dc:Bounds x="310" y="170" width="150" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Gateway_Wait" bpmnElement="Gateway_Wait" isMarkerVisible="true">
                <dc:Bounds x="510" y="175" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Catch_PaymentOutcome" bpmnElement="Catch_PaymentOutcome">
                <dc:Bounds x="612" y="82" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Gateway_Result" bpmnElement="Gateway_Result" isMarkerVisible="true">
                <dc:Bounds x="695" y="75" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_Active" bpmnElement="Task_Active">
                <dc:Bounds x="800" y="70" width="120" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_Failed" bpmnElement="Task_Failed">
                <dc:Bounds x="800" y="160" width="140" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_End_Failed" bpmnElement="End_Failed">
                <dc:Bounds x="992" y="172" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Catch_ActiveCancel" bpmnElement="Catch_ActiveCancel">
                <dc:Bounds x="972" y="82" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_CancellationRequested" bpmnElement="Task_CancellationRequested">
                <dc:Bounds x="1058" y="70" width="160" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_CancelledFromActive" bpmnElement="Task_CancelledFromActive">
                <dc:Bounds x="1270" y="70" width="150" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_End_CancelledActive" bpmnElement="End_CancelledActive">
                <dc:Bounds x="1472" y="82" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Catch_Cancel" bpmnElement="Catch_Cancel">
                <dc:Bounds x="612" y="282" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Task_Cancelled" bpmnElement="Task_Cancelled">
                <dc:Bounds x="700" y="270" width="120" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_End_Cancelled" bpmnElement="End_Cancelled">
                <dc:Bounds x="872" y="282" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Edge_Flow_1"    bpmnElement="Flow_1">
                <di:waypoint x="86"  y="200"/><di:waypoint x="130" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_2"    bpmnElement="Flow_2">
                <di:waypoint x="260" y="200"/><di:waypoint x="310" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_3"    bpmnElement="Flow_3">
                <di:waypoint x="460" y="200"/><di:waypoint x="510" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_4"    bpmnElement="Flow_4">
                <di:waypoint x="535" y="175"/><di:waypoint x="535" y="100"/><di:waypoint x="612" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_5"    bpmnElement="Flow_5">
                <di:waypoint x="535" y="225"/><di:waypoint x="535" y="300"/><di:waypoint x="612" y="300"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_6"    bpmnElement="Flow_6">
                <di:waypoint x="648" y="100"/><di:waypoint x="695" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_7"    bpmnElement="Flow_7">
                <di:waypoint x="745" y="100"/><di:waypoint x="800" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_Fail" bpmnElement="Flow_Fail">
                <di:waypoint x="720" y="125"/><di:waypoint x="720" y="190"/><di:waypoint x="800" y="190"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_10"   bpmnElement="Flow_10">
                <di:waypoint x="940" y="190"/><di:waypoint x="992" y="190"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_11"   bpmnElement="Flow_11">
                <di:waypoint x="648" y="300"/><di:waypoint x="700" y="300"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_12"   bpmnElement="Flow_12">
                <di:waypoint x="820" y="300"/><di:waypoint x="872" y="300"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_9"    bpmnElement="Flow_9">
                <di:waypoint x="920" y="100"/><di:waypoint x="972" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_13"   bpmnElement="Flow_13">
                <di:waypoint x="1008" y="100"/><di:waypoint x="1058" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_14"   bpmnElement="Flow_14">
                <di:waypoint x="1218" y="100"/><di:waypoint x="1270" y="100"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_Flow_15"   bpmnElement="Flow_15">
                <di:waypoint x="1420" y="100"/><di:waypoint x="1472" y="100"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
