<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="logDir">${spring:app.logging.path}</Property>
        <Property name="serviceName">finance-portal-backend</Property>
    </Properties>

    <Appenders>
        <Console name="ConsoleJson" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
        </Console>

        <RollingFile name="FileAppender"
                     fileName="${logDir}/app.log"
                     filePattern="${logDir}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <RollingFile name="JsonFile"
                     fileName="${logDir}/finance-portal/finance-portal-backend.json"
                     filePattern="${logDir}/finance-portal/finance-portal-backend-%d{yyyy-MM-dd}-%i.json.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="org.springframework.web" level="info" additivity="true" />
        <Logger name="org.hibernate.SQL" level="off" additivity="false" />
        <Logger name="org.hibernate.orm.jdbc.bind" level="off" additivity="false" />

        <SpringProfile name="local">
            <Logger name="com.emrehalli.financeportal" level="debug" additivity="true" />
            <Root level="info">
                <AppenderRef ref="ConsoleJson" />
                <AppenderRef ref="FileAppender" />
                <AppenderRef ref="JsonFile" />
            </Root>
        </SpringProfile>

        <SpringProfile name="!local">
            <Root level="info">
                <AppenderRef ref="ConsoleJson" />
                <AppenderRef ref="FileAppender" />
                <AppenderRef ref="JsonFile" />
            </Root>
        </SpringProfile>
    </Loggers>
</Configuration>
