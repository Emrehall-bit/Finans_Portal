<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="logDir">${spring:app.logging.path}</Property>
        <Property name="serviceName">finance-portal-backend</Property>
    </Properties>

    <Appenders>
        <Console name="ConsoleJson" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
        </Console>

        <RollingFile name="ApplicationFile"
                     fileName="${logDir}/application.log"
                     filePattern="${logDir}/archive/application-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <RollingFile name="ErrorFile"
                     fileName="${logDir}/error.log"
                     filePattern="${logDir}/archive/error-%d{yyyy-MM-dd}-%i.log.gz">
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY" />
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <RollingFile name="AccessFile"
                     fileName="${logDir}/access.log"
                     filePattern="${logDir}/archive/access-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <RollingFile name="AuditFile"
                     fileName="${logDir}/audit.log"
                     filePattern="${logDir}/archive/audit-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <RollingFile name="SchedulerFile"
                     fileName="${logDir}/scheduler.log"
                     filePattern="${logDir}/archive/scheduler-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>

        <!-- Kafka erişilemiyorsa ignoreExceptions=true sayesinde uygulama çökmez.
             reconnect.backoff.max.ms: Kafka yokken her 100ms'de bağlanmak yerine max 30s bekler → hata spam'i azalır. -->
        <Kafka name="KafkaAppender"
               topic="finance-portal-logs"
               syncSend="false"
               ignoreExceptions="true">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-event-template.json" />
            <Property name="bootstrap.servers">${env:KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}</Property>
            <Property name="acks">0</Property>
            <Property name="retries">0</Property>
            <Property name="linger.ms">100</Property>
            <Property name="max.block.ms">5000</Property>
            <Property name="reconnect.backoff.ms">3000</Property>
            <Property name="reconnect.backoff.max.ms">30000</Property>
        </Kafka>
    </Appenders>

    <Loggers>
        <!-- Kafka client loglarının KafkaAppender'a düşmesini engelle (recursive loop önlemi) -->
        <Logger name="org.apache.kafka" level="warn" additivity="false">
            <AppenderRef ref="ConsoleJson" />
            <AppenderRef ref="ApplicationFile" />
        </Logger>
        <!-- NetworkClient WARN seviyesinde "Connection could not be established / disconnected" spam'i üretir.
             Kafka erişilemezken her reconnect denemesinde fırlar; ERROR'a çekince sadece gerçek hatalar görünür. -->
        <Logger name="org.apache.kafka.clients.NetworkClient" level="error" additivity="false">
            <AppenderRef ref="ConsoleJson" />
            <AppenderRef ref="ApplicationFile" />
        </Logger>
        <Logger name="org.springframework.web" level="info" additivity="true" />
        <Logger name="org.hibernate.SQL" level="off" additivity="false" />
        <Logger name="org.hibernate.orm.jdbc.bind" level="off" additivity="false" />
        <Logger name="com.emrehalli.financeportal.common.logging.HttpRequestLoggingFilter" level="info" additivity="false">
            <AppenderRef ref="ConsoleJson" />
            <AppenderRef ref="AccessFile" />
            <AppenderRef ref="ErrorFile" />
            <AppenderRef ref="KafkaAppender" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.admin.service.AdminAuditLogService" level="info" additivity="true">
            <AppenderRef ref="AuditFile" />
        </Logger>
        <Logger name="AUDIT" level="info" additivity="false">
            <AppenderRef ref="ConsoleJson" />
            <AppenderRef ref="AuditFile" />
            <AppenderRef ref="ErrorFile" />
            <AppenderRef ref="KafkaAppender" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.alert.scheduler" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.scheduler" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.news.scheduler" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.service.TcmbFxHistoryBackfillAsyncService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.service.StockHistoryBackfillAsyncService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.service.TefasFundBackfillAsyncService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.service.TcmbFxHistoricalBackfillService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.market.service.TefasFundHistoricalBackfillService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>
        <Logger name="com.emrehalli.financeportal.company.service.CompanyFinancialBackfillService" level="info" additivity="true">
            <AppenderRef ref="SchedulerFile" />
        </Logger>

        <SpringProfile name="local">
            <Logger name="com.emrehalli.financeportal" level="debug" additivity="true" />
            <Root level="info">
                <AppenderRef ref="ConsoleJson" />
                <AppenderRef ref="ApplicationFile" />
                <AppenderRef ref="ErrorFile" />
                <AppenderRef ref="KafkaAppender" />
            </Root>
        </SpringProfile>

        <SpringProfile name="!local">
            <Root level="info">
                <AppenderRef ref="ConsoleJson" />
                <AppenderRef ref="ApplicationFile" />
                <AppenderRef ref="ErrorFile" />
                <AppenderRef ref="KafkaAppender" />
            </Root>
        </SpringProfile>
    </Loggers>
</Configuration>
